import json
import os
import re
import urllib.request
from pathlib import Path

USERNAME = os.environ.get("GITHUB_USERNAME", "arunessential")
TOKEN = os.environ.get("GITHUB_TOKEN", "")
SVG_PATH = Path("assets/profile-banner.svg")

def api(path):
    req = urllib.request.Request(
        f"https://api.github.com{path}",
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "arunessential-profile-updater",
            "Authorization": f"Bearer {TOKEN}",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    with urllib.request.urlopen(req, timeout=20) as response:
        return json.load(response)

user = api(f"/users/{USERNAME}")
repos = api(f"/users/{USERNAME}/repos?per_page=100&type=owner")

public_repos = user.get("public_repos", 0)
followers = user.get("followers", 0)
stars = sum(repo.get("stargazers_count", 0) for repo in repos)

svg = SVG_PATH.read_text(encoding="utf-8")

# Keep the visual design, but replace the live stat readout.
svg = re.sub(
    r'<text x="842" y="235".*?</text>',
    f'<text x="842" y="235" font-family="Segoe UI,Arial,sans-serif" font-size="30" font-weight="700" fill="#fff">{public_repos}</text>',
    svg,
    count=1,
)
svg = re.sub(
    r'<text x="842" y="255".*?</text>',
    '<text x="842" y="255" font-family="Segoe UI,Arial,sans-serif" font-size="12" fill="#94a3b8">public repositories</text>',
    svg,
    count=1,
)
svg = re.sub(
    r'<text x="842" y="313".*?</text>',
    f'<text x="842" y="313" font-family="Segoe UI,Arial,sans-serif" font-size="30" font-weight="700" fill="#fff">{followers}</text>',
    svg,
    count=1,
)
svg = re.sub(
    r'<text x="842" y="333".*?</text>',
    '<text x="842" y="333" font-family="Segoe UI,Arial,sans-serif" font-size="12" fill="#94a3b8">GitHub followers</text>',
    svg,
    count=1,
)

# Put star count into the terminal status text.
svg = svg.replace(
    "● LIVE PROFILE",
    f"● {stars} public stars"
)

SVG_PATH.write_text(svg, encoding="utf-8")
print(f"Updated banner for {USERNAME}: repos={public_repos}, followers={followers}, stars={stars}")
