name: Update Profile Banner

on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-banner:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout profile repository
        uses: actions/checkout@v4

      - name: Update dynamic profile banner
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITHUB_USERNAME: arunessential
        run: |
          python3 scripts/update_banner.py

      - name: Commit updated banner
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add assets/profile-banner.svg
          if git diff --cached --quiet; then
            echo "No banner changes."
          else
            git commit -m "chore: update profile statistics"
            git push
          fi
